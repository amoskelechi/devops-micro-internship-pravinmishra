#!/bin/bash
# Pre-commit hook: block secrets and oversized files

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
BLOCKED=0

for FILE in $STAGED_FILES; do
    if grep -E "AKIA[0-9A-Z]{16}|(password|secret|api_key)\s*=\s*['\"][^'\"]+['\"]" "$FILE" > /dev/null 2>&1; then
        echo "BLOCKED: Potential secret detected in $FILE"
        BLOCKED=1
    fi

    if [ -f "$FILE" ]; then
        FILESIZE=$(stat -c%s "$FILE" 2>/dev/null || stat -f%z "$FILE")
        if [ "$FILESIZE" -gt 1048576 ]; then
            echo "BLOCKED: $FILE exceeds 1MB limit ($FILESIZE bytes)"
            BLOCKED=1
        fi
    fi
done

if [ "$BLOCKED" -eq 1 ]; then
    echo "Commit rejected. Fix the issues above before committing."
    exit 1
fi

exit 0
